{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Ownership Transfer",
    "type": "object",
    "required": [
        "transferDate",
        "fromOwner",
        "toOwner",
        "updatedSOH",
        "sellerSignature",
        "buyerSignature"
    ],
    "properties": {
        "transferDate": {
            "type": "string",
            "format": "date-time"
        },
        "fromOwner": {
            "type": "string"
        },
        "toOwner": {
            "type": "string"
        },
        "updatedSOH": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
        },
        "verificationMethod": {
            "type": "string"
        },
        "sellerSignature": {
            "type": "string"
        },
        "buyerSignature": {
            "type": "string"
        }
    }
}