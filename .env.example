# Network Configuration
RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=your_private_key_here

# Backend Service Keys (Can be the same as PRIVATE_KEY for testing)
# These are used by the backend to sign transactions for each role.
OEM_KEY=your_private_key_here
SERVICE_KEY=your_private_key_here
RECYCLER_KEY=your_private_key_here
OWNER_KEY=your_private_key_here

# Contract Configuration (Fill this after running deployment script)
CONTRACT_ADDRESS=

# Frontend Configuration (Optional if using the above, but common in Next.js)
NEXT_PUBLIC_CONTRACT_ADDRESS=
